{
  "expo": {
    "name": "OHh Finance",
    "slug": "ohh-finance-mobile",
    "version": "1.0.0",
    "scheme": "ohh-finance",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.organizedhousehold.ohhfinance"
    },
    "android": {
      "package": "com.organizedhousehold.ohhfinance",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
